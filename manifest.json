{
  "manifest_version": 3,
  "name": "ChatRivet",
  "version": "1.2.0",
  "description": "ChatGPTの左サイドバーに、ローカル保存の独自ピン一覧を追加する拡張機能。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
